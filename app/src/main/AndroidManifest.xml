<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- A light tick on each volume step. -->
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- Only with the island's Calendar events switched on: the next event, read on the phone. -->
    <uses-permission android:name="android.permission.READ_CALENDAR" />
    <!-- In-app updates: checks and downloads new builds from the GitHub releases, then installs them. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!-- Lets later updates install without a prompt once this app installed the current one. -->
    <uses-permission android:name="android.permission.UPDATE_PACKAGES_WITHOUT_USER_ACTION" />
    <!-- Granted once over ADB or Shizuku; lets the app find other apps' audio sessions. -->
    <uses-permission
        android:name="android.permission.DUMP"
        tools:ignore="ProtectedPermissions" />
    <!-- Granted once over ADB or Shizuku; lets the island switch Android's own notification
         pop-ups off while it shows them, and back on when it stops. -->
    <uses-permission
        android:name="android.permission.WRITE_SECURE_SETTINGS"
        tools:ignore="ProtectedPermissions" />
    <!-- Needed to turn the uids in the audio dump into app names. -->
    <uses-permission
        android:name="android.permission.QUERY_ALL_PACKAGES"
        tools:ignore="QueryAllPackagesPermission" />

    <!-- Continuum Keyboard, a separate app this one installs, updates and opens. -->
    <queries>
        <package android:name="dev.continuum.keyboard" />
    </queries>

    <application
        android:name=".ContinuumApp"
        android:allowAudioPlaybackCapture="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher"
        android:supportsRtl="true"
        android:theme="@style/Theme.Continuum">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- "Open with" for EQ text files exported from squig.link or AutoEQ -->
            <intent-filter android:label="@string/import_eq">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="content" />
                <data android:mimeType="text/plain" />
            </intent-filter>
            <!-- Long-pressing a Continuum tile in Quick Settings opens the app there. -->
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE_PREFERENCES" />
            </intent-filter>
            <!-- "Share" of EQ text or files -->
            <intent-filter android:label="@string/import_eq">
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity>

        <!-- Replying from the island: an ink card that grows out of it, over whatever is open. -->
        <activity
            android:name=".island.ReplyActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:noHistory="true"
            android:taskAffinity=""
            android:theme="@style/Theme.Continuum.Reply"
            android:windowSoftInputMode="stateVisible|adjustResize" />

        <service
            android:name=".audio.CaptureService"
            android:exported="false"
            android:foregroundServiceType="mediaProjection" />

        <!-- The island: drawn by an accessibility service, fed by a notification listener. -->
        <service
            android:name=".island.IslandAccessibilityService"
            android:exported="true"
            android:label="@string/island_service_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/island_accessibility" />
        </service>

        <!-- The volume panel: the volume keys, caught by an accessibility service. -->
        <service
            android:name=".volume.VolumeService"
            android:exported="true"
            android:label="@string/volume_service_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/volume_accessibility" />
        </service>

        <!-- Raises the volume panel from Quick Settings: an activity is what folds the shade away. -->
        <activity
            android:name=".volume.VolumeTrampoline"
            android:exported="false"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:taskAffinity=""
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />

        <service
            android:name=".island.IslandNotificationListener"
            android:exported="true"
            android:label="@string/island_listener_label"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <!-- Quick Settings tiles. -->
        <service
            android:name=".tiles.EqTile"
            android:exported="true"
            android:icon="@drawable/ic_wave"
            android:label="@string/tile_eq"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
            <meta-data
                android:name="android.service.quicksettings.TOGGLEABLE_TILE"
                android:value="true" />
        </service>
        <service
            android:name=".tiles.IslandTile"
            android:exported="true"
            android:icon="@drawable/ic_island"
            android:label="@string/tile_island"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
            <meta-data
                android:name="android.service.quicksettings.TOGGLEABLE_TILE"
                android:value="true" />
        </service>
        <service
            android:name=".tiles.VolumeTile"
            android:exported="true"
            android:icon="@drawable/ic_volume"
            android:label="@string/tile_volume"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <receiver
            android:name=".update.InstallReceiver"
            android:exported="false" />

        <!-- Only Android sends this; it says the app has just been updated. -->
        <receiver
            android:name=".update.UpdatedReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <provider
            android:name="rikka.shizuku.ShizukuProvider"
            android:authorities="${applicationId}.shizuku"
            android:enabled="true"
            android:exported="true"
            android:multiprocess="false"
            android:permission="android.permission.INTERACT_ACROSS_USERS_FULL" />
    </application>
</manifest>
