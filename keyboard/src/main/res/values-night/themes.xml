<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Dark at night, and saying so: a light theme here gets inverted by Android's expanded dark theme. -->
    <style name="Theme.Continuum" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/ground</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>
</resources>
